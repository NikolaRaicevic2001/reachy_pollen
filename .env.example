# OpenAI
OPENAI_API_KEY=sk-proj
OPENAI_MODEL=gpt-4o

# Robot
REACHY_HOST=192.168.10.172

# Write run logs + token usage under reachy_system2/runs/<timestamp>/ (1=yes, 0=no)
SYSTEM2_LOG_RUNS=1

# Perception / loop tuning
SETTLING_S=0.75
PERCEPTION_FREQ=40
PERCEPTION_DETECTION_THRESHOLD=0.1

# Closed loop: wait for detections before LLM plan 
SYSTEM2_SNAPSHOT_MAX_ATTEMPTS=20
PERCEPTION_RETRY_SETTLING_S=0.5

# Transit height: z_safe = max(tcp_z+MIN_LIFT, support_z+MARGIN) from perception + ROBOT_STATE
SYSTEM2_CLEARANCE_MARGIN_M=0.15
SYSTEM2_MIN_LIFT_ABOVE_TCP_M=0.12
SYSTEM2_LINK_CLEARANCE_M=0.10
SYSTEM2_SUPPORT_XY_RADIUS_M=0.70
SYSTEM2_HOVER_ABOVE_OBJECT_M=0.12

# After FAILED verification: recovery replan attempts per planned subtask
SYSTEM2_MAX_VERIFY_RETRIES=2

# Safe workspace box (robot frame, meters)
SAFE_WORKSPACE_XMIN=-0.20
SAFE_WORKSPACE_XMAX=0.85
SAFE_WORKSPACE_YMIN=-0.65
SAFE_WORKSPACE_YMAX=0.65
SAFE_WORKSPACE_ZMIN=-0.55
SAFE_WORKSPACE_ZMAX=0.55

# System2 Task and vision labels (OWL-ViT / Perception)
SYSTEM2_TASK="Pick up the tomato soup can and place it into the metal bowl"
SYSTEM2_LABELS=cylindrical tomato soup can, metal bowl, table