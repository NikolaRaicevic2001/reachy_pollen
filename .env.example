# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Optional: non-default API host (Azure, proxy, OpenAI-compatible gateway)
# OPENAI_BASE_URL=

# TLS: `reachy_system2.reasoning` and the walkthrough notebook use certifi for HTTPS verify
# (fixes SSL: CERTIFICATE_VERIFY_FAILED on some Windows installs). SSL_CERT_FILE below is optional
# for other processes; it does not always apply to httpx inside the OpenAI SDK.
#   python -c "import certifi; print(certifi.where())"
# SSL_CERT_FILE=C:\path\to\certifi\cacert.pem

# Robot
REACHY_HOST=192.168.10.172

# Write run logs + token usage under reachy_system2/runs/<timestamp>/ (1=yes, 0=no)
SYSTEM2_LOG_RUNS=1

# Perception / loop tuning
SETTLING_S=0.75
PERCEPTION_FREQ=40
PERCEPTION_DETECTION_THRESHOLD=0.1

# Safe workspace axis-aligned box in robot frame (meters). Executor rejects Cartesian targets outside.
SAFE_WORKSPACE_XMIN=0.1
SAFE_WORKSPACE_XMAX=0.8
SAFE_WORKSPACE_YMIN=-0.6
SAFE_WORKSPACE_YMAX=0.6
SAFE_WORKSPACE_ZMIN=-0.5
SAFE_WORKSPACE_ZMAX=0.5

# System2 Tasks
SYSTEM2_TASK="Pick up the tomato soup can and place it into the metal bowl"
SYSTEM2_LABELS="tomato soup can, metal bowl"